{
  "name": "memcached-workspace",
  "private": true,
  "description": "pnpm workspace for @platformatic/memcached and related packages",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">= 22.12.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "typecheck": "pnpm -r typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "benchmark": "pnpm --filter @platformatic/memcached benchmark"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/memcached.git"
  },
  "bugs": {
    "url": "https://github.com/platformatic/memcached/issues"
  },
  "author": "Platformatic Inc. <oss@platformatic.dev> (https://platformatic.dev)",
  "devDependencies": {
    "eslint": "^9.0.0",
    "neostandard": "^0.12.0",
    "typescript": "^6.0.3"
  }
}
