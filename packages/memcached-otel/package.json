{
  "name": "@platformatic/memcached-otel",
  "version": "0.1.2",
  "description": "OpenTelemetry tracing instrumentation for @platformatic/memcached, built on its diagnostics channels",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">= 22.12.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "pretest": "pnpm --filter @platformatic/memcached build && (docker run -d --rm --name plt-memcached-otel-test -p 11211:11211 memcached:alpine > /dev/null 2>&1 || true)",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "posttest": "docker rm -f plt-memcached-otel-test > /dev/null 2>&1 || true"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/platformatic/memcached.git",
    "directory": "packages/memcached-otel"
  },
  "bugs": {
    "url": "https://github.com/platformatic/memcached/issues"
  },
  "author": "Platformatic Inc. <oss@platformatic.dev> (https://platformatic.dev)",
  "dependencies": {
    "@opentelemetry/instrumentation": "^0.222.0"
  },
  "peerDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@platformatic/memcached": "workspace:^"
  },
  "devDependencies": {
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/sdk-trace-base": "^2.9.0",
    "@platformatic/memcached": "workspace:^",
    "@types/node": "^24.0.0",
    "typescript": "^6.0.3"
  },
  "keywords": [
    "memcached",
    "opentelemetry",
    "tracing",
    "instrumentation",
    "diagnostics_channel"
  ]
}
